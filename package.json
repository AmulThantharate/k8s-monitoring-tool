{
  "name": "k8s-monitoring-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "infra:up": "docker compose -f docker-compose.local.yml up -d",
    "infra:down": "docker compose -f docker-compose.local.yml down",
    "backend:dev": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 4000 --reload",
    "backend:start": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 4000",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
